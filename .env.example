# ==============================================================================
# Advanced RAG Platform - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace placeholder values with your credentials.
# NEVER commit .env containing actual secrets to version control.
# ==============================================================================

# Application Configuration
APP_NAME=Advanced-RAG-Platform
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
SECRET_KEY=change_this_to_a_secure_random_secret_in_production
FRONTEND_URL=https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (MySQL)
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/advanced_rag
TEST_DATABASE_URL=mysql+pymysql://user:password@localhost:3306/advanced_rag_test

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=rag_document_chunks

# LLM & AI Services (OpenRouter / NVIDIA Nemotron)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TEMPERATURE=0.2
OPENROUTER_MAX_TOKENS=2048
OPENROUTER_TIMEOUT=30.0
OPENROUTER_APP_NAME=Advanced-RAG-Platform
OPENROUTER_HTTP_REFERER=http://localhost:8000

# Embeddings Configuration
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Authentication & Security
JWT_SECRET_KEY=change_this_jwt_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# File Storage & Ingestion Limits
UPLOAD_STORAGE_DIR=./storage/uploads
MAX_FILE_SIZE_MB=25
ALLOWED_FILE_EXTENSIONS=.pdf,.docx,.txt

# Chunking & Retrieval Parameters
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=5
SCORE_THRESHOLD=0.5
ENABLE_RERANKING=False
RERANKING_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
